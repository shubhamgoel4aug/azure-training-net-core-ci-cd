@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>

    <div class="mt-4">
        <button id="checkHealthBtn" class="btn btn-primary">Check API health</button>
        <button id="loadUsersBtn" class="btn btn-secondary ms-2">Load Users</button>
        <button id="loadImageBtn" class="btn btn-success ms-2">Load Image</button>
    </div>

    <div class="mt-3">
        <input id="orderIdInput" placeholder="Order ID" class="form-control d-inline-block" style="width:200px" />
        <input id="statusInput" placeholder="Status" class="form-control d-inline-block ms-2" style="width:200px" />
        <button id="callFunctionBtn" class="btn btn-info ms-2">Run Azure Function (HTTP trigger)</button>
    </div>

    <pre id="healthResult" class="mt-3 text-start" style="white-space:pre-wrap;"></pre>
    <pre id="usersResult" class="mt-3 text-start" style="white-space:pre-wrap;"></pre>
    <pre id="functionResult" class="mt-3 text-start" style="white-space:pre-wrap;"></pre>

    <div id="imageContainer" class="mt-3">
        <img id="blobImage" src="" alt="Blob image" style="max-width:100%; display:none;" />
        <div id="imageError" style="color:crimson"></div>
    </div>
</div>

<!-- Render antiforgery token into a hidden form so JS can read it -->
<form id="antiforgeryForm" style="display:none">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');

        var healthBtn = document.getElementById('checkHealthBtn');
        var healthOut = document.getElementById('healthResult');

        healthBtn.onclick = function () {
            healthBtn.disabled = true;
            healthBtn.textContent = 'Checking...';
            healthOut.textContent = '';

            fetch('?handler=CheckHealth', { method: 'GET', headers: { 'Accept': 'application/json' } })
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    if (data.error) {
                        healthOut.textContent = 'Error: ' + data.error;
                    } else {
                        healthOut.textContent = 'Status: ' + data.status + '\n\nBody:\n' + data.body;
                    }
                })
                .catch(function (e) {
                    healthOut.textContent = 'Fetch failed: ' + (e && e.message ? e.message : e);
                })
                .finally(function () {
                    healthBtn.disabled = false;
                    healthBtn.textContent = 'Check API health';
                });
        };

        var usersBtn = document.getElementById('loadUsersBtn');
        var usersOut = document.getElementById('usersResult');

        usersBtn.onclick = function () {
            usersBtn.disabled = true;
            usersBtn.textContent = 'Loading...';
            usersOut.textContent = '';

            fetch('?handler=ReadUsers', { method: 'GET', headers: { 'Accept': 'application/json' } })
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    if (data.error) {
                        usersOut.textContent = 'Error: ' + data.error;
                        return;
                    }

                    var text = 'Users count: ' + (data.count || 0) + '\n\n';
                    var items = data.items || [];
                    for (var i = 0; i < items.length; i++) {
                        var row = items[i];
                        var parts = [];
                        for (var key in row) {
                            parts.push(key + ': ' + row[key]);
                        }
                        text += (i + 1) + '. ' + parts.join(' | ') + '\n';
                    }
                    usersOut.textContent = text;
                })
                .catch(function (e) {
                    usersOut.textContent = 'Fetch failed: ' + (e && e.message ? e.message : e);
                })
                .finally(function () {
                    usersBtn.disabled = false;
                    usersBtn.textContent = 'Load Users';
                });
        };

        var imgBtn = document.getElementById('loadImageBtn');
        var img = document.getElementById('blobImage');
        var imgErr = document.getElementById('imageError');

        imgBtn.onclick = function () {
            imgBtn.disabled = true;
            imgBtn.textContent = 'Loading...';
            img.style.display = 'none';
            img.src = '';
            imgErr.textContent = '';

            // If you want to pass a blob name, append &blobName=yourfile.jpg
            fetch('?handler=GetImageSas', { method: 'GET', headers: { 'Accept': 'application/json' } })
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    if (data.error) {
                        imgErr.textContent = 'Error: ' + data.error;
                        return;
                    }

                    img.src = data.url;
                    img.style.display = 'block';
                })
                .catch(function (e) {
                    imgErr.textContent = 'Fetch failed: ' + (e && e.message ? e.message : e);
                })
                .finally(function () {
                    imgBtn.disabled = false;
                    imgBtn.textContent = 'Load Image';
                });
        };

        var orderIdInput = document.getElementById('orderIdInput');
        var statusInput = document.getElementById('statusInput');
        var funcBtn = document.getElementById('callFunctionBtn');
        var funcOut = document.getElementById('functionResult');

        // Send JSON body and include antiforgery token header
        funcBtn.onclick = function () {
            var orderId = orderIdInput.value || '';
            var status = statusInput.value || '';

            funcBtn.disabled = true;
            funcBtn.textContent = 'Calling...';
            funcOut.textContent = '';

            var payload = JSON.stringify({ orderId: orderId, status: status });
            var headers = {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            };

            if (tokenInput && tokenInput.value) {
                headers['RequestVerificationToken'] = tokenInput.value;
            }

            fetch('?handler=CallFunction', {
                method: 'POST',
                headers: headers,
                body: payload
            })
                .then(function (res) {
                    return res.text().then(function (text) {
                        if (!text) {
                            return { error: 'Empty response from server', status: res.status };
                        }
                        try {
                            return JSON.parse(text);
                        } catch (ex) {
                            return { error: 'Invalid JSON response', status: res.status, raw: text };
                        }
                    });
                })
                .then(function (data) {
                    if (data.error) {
                        funcOut.textContent = 'Error: ' + data.error + (data.raw ? '\n\nRaw:\n' + data.raw : '');
                    } else {
                        funcOut.textContent = 'Status: ' + data.status + '\n\nBody:\n' + data.body;
                    }
                })
                .catch(function (e) {
                    funcOut.textContent = 'Fetch failed: ' + (e && e.message ? e.message : e);
                })
                .finally(function () {
                    funcBtn.disabled = false;
                    funcBtn.textContent = 'Call Function';
                });
        };
    </script>
}
